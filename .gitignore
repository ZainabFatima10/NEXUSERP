# n8n credential files filled in with real secrets (templates are tracked).
# The directory is blockchain-module-main/n8n-workflows/, not a root-level
# one — a leading-slash-free pattern with an internal "/" anchors to the
# .gitignore's own location (repo root), so it silently matched nothing
# until this "**/" was added. Verify with `git check-ignore -v <path>`
# after touching this.
**/n8n-workflows/*-credential.json
!**/n8n-workflows/*.template.json

# Node / Frontend
node_modules/
dist/
.DS_Store
