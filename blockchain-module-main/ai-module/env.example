# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus_erp
DB_USER=nexus_user
DB_PASSWORD=nexus_pass

# ── Email (Gmail App Password) ────────────────────────────────────────────────
# Leave blank for dev-mode (emails printed to console instead of sent)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_NAME=NEXUS ERP — PowerGrid Optimizer

# ── Base URL (used in email confirm links) ────────────────────────────────────
BASE_URL=http://localhost:8000

# ── Auth / RBAC (see RBAC_WIRING.md) ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_64_char_hex_string
JWT_EXPIRE_MINUTES=1440

# ── ML Models (Module 1) ──────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_key_here

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
