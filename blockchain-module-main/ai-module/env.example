# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus_erp
DB_USER=nexus_user
DB_PASSWORD=nexus_pass

# ── Email (Gmail App Password) ────────────────────────────────────────────────
# Leave blank for dev-mode (emails printed to console instead of sent)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_NAME=NEXUS ERP — PowerGrid Optimizer

# ── Base URL (used in email confirm links) ────────────────────────────────────
# Must be reachable by whoever clicks the link (vendor/customer), not just this
# machine. For a one-off demo with a real vendor email, run a free tunnel and
# put its URL here instead: `cloudflared tunnel --url http://localhost:8000`
BASE_URL=http://localhost:8000

# ── Auth / RBAC (see RBAC_WIRING.md) ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_64_char_hex_string
JWT_EXPIRE_MINUTES=1440

# ── Procurement automation (see N8N_AUTOMATION_WIRING.md) ─────────────────────
# Self-hosted n8n (docker compose up -d n8n) listens on :5678 by default.
# Two workflows, both under blockchain-module-main/n8n-workflows/:
#   vendor-reorder-email.workflow.json          — bill + Accept/Reject buttons
#   vendor-contract-confirmation.workflow.json  — sent after vendor accepts,
#                                                  with a copy of the executed
#                                                  smart contract / bill
N8N_WEBHOOK_URL=http://localhost:5678/webhook/vendor-reorder-email
N8N_CONTRACT_CONFIRMATION_WEBHOOK_URL=http://localhost:5678/webhook/vendor-contract-confirmation
# Shared secret sent as X-Webhook-Secret on every POST to n8n, and required by
# both workflows' Header Auth credential (see n8n-workflows/README.md).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_WEBHOOK_SECRET=

# ── VEMA voice pipeline (see VEMA_BACKEND_WIRING.md, llm_client.py) ────────────
# LLM provider priority: Gemini first (free tier, no card required — get a key
# at https://aistudio.google.com/apikey), then Mistral if only that's set, else
# the deterministic keyword-classifier dev-mode fallback. Leave both blank to
# run dev-mode.
GEMINI_API_KEY=
# Verified against a real key 2026-09-29 — gemini-2.5-flash-lite responded
# reliably; gemini-flash-latest and gemini-3.8-flash both 503'd ("high
# demand") at the time. Model names on this API move fast — if this one
# stops working, GET /v1beta/models?key=... (with your own key) to see
# what's actually available and swap it here.
GEMINI_MODEL=gemini-2.5-flash-lite
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
WHISPER_MODEL_SIZE=base
KOKORO_VOICE=af_heart

# ── VEMA RAG — Q&A + complaint grounding (see VEMA_RAG.md) ─────────────────────
# Embeddings: Gemini's API (reuses GEMINI_API_KEY above, gemini-embedding-001
# truncated to 768-dim) if set, else a local scikit-learn HashingVectorizer
# fallback (also 768-dim, so the schema doesn't care which is active) —
# sentence-transformers/torch cannot load on a machine with this Windows
# Application Control policy; see VEMA_RAG.md "Embedding model" before
# assuming a different environment needs the same workaround.
# text-embedding-004 (the original plan) is retired; gemini-embedding-001
# is its replacement, natively 3072-dim — rag/embeddings.py requests
# outputDimensionality=768 explicitly (a supported Matryoshka-style
# truncation) to match this schema's vector(768) column.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=5
# Calibrated for the hashing fallback (weak on paraphrase) — raise substantially
# (0.6-0.8) if you switch to a real semantic embedding model. See retrieval.py.
RAG_MIN_SIMILARITY=0.05
# Index anonymized resolved-ticket summaries for "similar cases" (staff-only)
# and classification grounding. Defaults on because the PII-scrub test suite
# (tests/test_pii.py) passes; set to false to opt out entirely.
RAG_INDEX_RESOLVED_TICKETS=true

# ── Vendor Orders — Phase 2 (see VENDOR_ONBOARDING.md / SHIPMENT_ESCROW.md) ───
# The marketing site's own base URL — vendor-facing Accept/Reject and
# shipment-update links point here (React pages), NOT at BASE_URL (the
# backend API). Must be reachable by whoever clicks the link.
FRONTEND_URL=http://localhost:5173

# Four more n8n workflows, distinct from the Phase 1 ones above — all
# under blockchain-module-main/n8n-workflows/:
#   vendor-order-email.workflow.json             — new order, Accept/Reject
#   vendor-order-shipment-link.workflow.json     — sent after accept, gives
#                                                   the vendor their no-login
#                                                   shipment-update link
#   vendor-order-payment-released.workflow.json  — sent once the contract
#                                                   executes and payment is
#                                                   captured
#   vendor-order-status-checkin.workflow.json    — sent ~3x/day while a
#                                                   shipment is in flight,
#                                                   nudging for a status
#                                                   update (see
#                                                   VENDOR_STATUS_CHECKIN_INTERVAL_HOURS)
N8N_VENDOR_ORDER_WEBHOOK_URL=http://localhost:5678/webhook/vendor-order-email
N8N_VENDOR_ORDER_SHIPMENT_LINK_WEBHOOK_URL=http://localhost:5678/webhook/vendor-order-shipment-link
N8N_VENDOR_ORDER_PAYMENT_RELEASED_WEBHOOK_URL=http://localhost:5678/webhook/vendor-order-payment-released
N8N_VENDOR_ORDER_STATUS_CHECKIN_WEBHOOK_URL=http://localhost:5678/webhook/vendor-order-status-checkin

# How long a vendor has to Accept/Reject before an order expires, and how
# long before expiry (or ETA/arrival) to send the one reminder nudge.
VENDOR_ORDER_RESPONSE_HOURS=72
VENDOR_REMINDER_HOURS_BEFORE_EXPIRY=24
ARRIVAL_REMINDER_HOURS_AFTER_ETA=24
APPROVAL_REMINDER_HOURS_AFTER_ARRIVAL=48
# How often (hours) to nudge the vendor for a delivery status update while
# a shipment is in flight — default 8h gives ~3 check-ins/day.
VENDOR_STATUS_CHECKIN_INTERVAL_HOURS=8

# ── ShipmentEscrow — real on-chain contract (see blockchain-module-main/hardhat/) ─
# Leave CHAIN_RPC_URL blank to run Phase 2 fully in dev mode: every chain
# call prints what it would have done instead of posting, exactly like the
# n8n/email dev-mode fallbacks above — no blockchain infra needed to use
# the rest of the feature.
CHAIN_NETWORK=hardhat
# hardhat (in-memory, tests only) | localhost (a running `npx hardhat node`)
# | sepolia (public testnet — see SHIPMENT_ESCROW.md)
CHAIN_RPC_URL=http://127.0.0.1:8545
# The backend's own LOGISTICS_ROLE/ADMIN_ROLE signer — one of Hardhat's
# default funded dev accounts when running locally. NEVER a real-value key.
CHAIN_SIGNER_PRIVATE_KEY=
# Only needed if it differs from hardhat/deployments/<CHAIN_NETWORK>.json's
# recorded address (e.g. deployed once, address reused across restarts).
CONTRACT_ADDRESS=
# Encrypts each user's backend-custodied chain wallet private key at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank for dev-mode (an in-memory key is generated per process —
# wallets created before a restart become unreadable after one; fine for
# local dev, never for anything persistent).
WALLET_ENCRYPTION_KEY=
# Auto-top-up amount/threshold (ETH) for a user's chain wallet before it
# signs a transaction — Hardhat's default accounts start with 10000 ETH,
# so the defaults below are generous for local dev.
WALLET_FUND_AMOUNT_ETH=0.05
WALLET_FUND_THRESHOLD_ETH=0.01

# ── ML Models (Module 1) ──────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_key_here

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
