{
  "id": "vendor-contract-confirmation-wf",
  "name": "NEXUS ERP — Vendor Contract Confirmation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vendor-contract-confirmation",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-vendor-contract-confirmation",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "vendor-contract-confirmation-hook",
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Nexus Webhook Secret"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SMTP_USER}}",
        "toEmail": "={{$json.body.vendor_email}}",
        "subject": "=Smart Contract Created — Order {{$json.body.order_code}} Confirmed",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:'DM Sans',Arial,sans-serif;background:#f4f7fb;padding:32px 16px;\"><div style=\"max-width:560px;margin:0 auto;background:#fff;border-radius:16px;padding:40px;box-shadow:0 8px 32px rgba(0,0,0,0.08);\"><h1 style=\"color:#001F54;font-size:22px;margin:0 0 4px;\">NEXUS ERP</h1><p style=\"color:#888;font-size:13px;margin:0 0 24px;\">PowerGrid Optimizer — Automated Procurement</p><div style=\"background:#f0f9f4;border:1px solid #cdeedb;border-radius:12px;padding:16px 20px;margin-bottom:24px;\"><p style=\"color:#2e7d5e;font-weight:700;margin:0;font-size:15px;\">✅ Order Accepted — Smart Contract Created</p></div><p style=\"color:#333;line-height:1.6;\">Dear {{$json.body.vendor_name}},</p><p style=\"color:#333;line-height:1.6;\">Thank you for accepting order <strong>{{$json.body.order_code}}</strong>. A smart contract has now been created and executed on the NEXUS ERP procurement ledger. Attached below is a copy of the final bill for your records.</p><table style=\"width:100%;border-collapse:collapse;margin:20px 0;font-size:14px;\"><tr><td style=\"padding:6px 0;color:#888;\">Order</td><td style=\"padding:6px 0;text-align:right;font-weight:600;color:#001F54;\">{{$json.body.order_code}}</td></tr><tr><td style=\"padding:6px 0;color:#888;\">Item</td><td style=\"padding:6px 0;text-align:right;\">{{$json.body.item_name}}</td></tr><tr><td style=\"padding:6px 0;color:#888;\">Quantity</td><td style=\"padding:6px 0;text-align:right;\">{{$json.body.quantity}} {{$json.body.unit}}</td></tr><tr><td style=\"padding:6px 0;color:#888;\">Contract Hash</td><td style=\"padding:6px 0;text-align:right;font-family:monospace;font-size:11px;\">{{$json.body.contract_hash}}</td></tr><tr><td style=\"padding:6px 0;color:#888;\">Execution Hash</td><td style=\"padding:6px 0;text-align:right;font-family:monospace;font-size:11px;\">{{$json.body.execution_hash}}</td></tr></table><table style=\"width:100%;border-collapse:collapse;margin:12px 0 20px;font-size:13px;border-top:1px solid #eee;\"><tr style=\"color:#888;\"><td style=\"padding:8px 0;\">Description</td><td style=\"padding:8px 0;text-align:center;\">Qty</td><td style=\"padding:8px 0;text-align:right;\">Unit Price</td><td style=\"padding:8px 0;text-align:right;\">Amount</td></tr>{{$json.body.invoice.line_items.map(li => `<tr style=\"border-top:1px solid #f0f0f0;\"><td style=\"padding:8px 0;\">${li.description}</td><td style=\"padding:8px 0;text-align:center;\">${li.quantity}</td><td style=\"padding:8px 0;text-align:right;\">${li.unit_price}</td><td style=\"padding:8px 0;text-align:right;\">${li.amount}</td></tr>`).join('')}}<tr><td colspan=\"3\" style=\"padding:12px 0 0;text-align:right;font-weight:700;color:#001F54;\">Total</td><td style=\"padding:12px 0 0;text-align:right;font-weight:700;color:#001F54;\">{{$json.body.invoice.total}}</td></tr></table><div style=\"text-align:center;margin:28px 0 12px;\"><a href=\"{{$json.body.invoice_pdf_url}}\" style=\"display:inline-block;background:#001F54;color:#fff;text-decoration:none;font-weight:700;padding:14px 36px;border-radius:24px;\">📄 Download Bill (PDF)</a></div><p style=\"color:#aaa;font-size:11px;margin-top:32px;\">This is an automated confirmation — no further action is needed. Delivery tracking updates will follow separately.</p></div></div>",
        "options": {}
      },
      "id": "email-vendor-contract-confirmation",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [520, 300],
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "Nexus SMTP"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          { "node": "Send Email", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
